{
  "name": "rhythmsense-signal-ingestion",
  "version": "2.1.0",
  "description": "RhythmSense Signal Ingestion Service: PPG window intake, validation and signal-quality gating (IEC 62304 class B software item)",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest",
    "test:ci": "jest --ci --reporters=default --reporters=jest-junit"
  },
  "dependencies": {
    "axios": "1.20.0",
    "fastify": "4.28.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "20.17.10",
    "jest": "29.7.0",
    "jest-junit": "16.0.0",
    "ts-jest": "29.2.5",
    "typescript": "5.7.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/test/**/*.test.ts"]
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "junit.xml",
    "suiteName": "rhythmsense-signal-ingestion",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}"
  }
}
